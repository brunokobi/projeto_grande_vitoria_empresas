# Copie este arquivo para ".env" e preencha/ajuste os valores.
# Carregue com:  set -a && source .env && set +a   (recomendado no zsh/bash)
# ou use python-dotenv se preferir carregar automaticamente.
#
# IMPORTANTE: o .env NÃO é versionado (está no .gitignore). Nunca coloque
# chaves/tokens reais em arquivo versionado num repositório público.

# --- APIs com chave --------------------------------------------------------
# DataJud (CNJ): chave PÚBLICA única, compartilhada por todos. Já vem com
# fallback embutido em config.py, então esta variável é OPCIONAL — só
# preencha se o CNJ trocar a chave (sinal: erro 401/403 na etapa datajud).
# Chave atualizada em: https://datajud-wiki.cnj.jus.br/api-publica/acesso/
# OBS: deixar vazio (=) funciona; o código usa o fallback nesse caso.
DATAJUD_API_KEY=

# Nominatim/OSM exige um User-Agent identificando a aplicação (política de
# uso obrigatória). Não precisa de chave nem cartão. Coloque um contato real
# (e-mail ou site). Mantenha entre aspas — os parênteses quebram o `source`
# se o valor estiver sem aspas.
NOMINATIM_USER_AGENT="grande-vitoria-empresas-dataset/1.0 (seu-email@dominio.com)"

# --- URLs de arquivo das fontes públicas ------------------------------------
# Valores abaixo verificados e funcionando em 22/07/2026. Ver notas em config.py.

# Portal da Transparência (CGU): estas 3 são URL de PÁGINA (o link do arquivo
# só é gerado via JS após escolher o período, e o site tem WAF). A validação
# em src/url_validation.py rejeita essas 3 e a etapa `sancoes` as PULA com
# mensagem clara. Pra ativar de verdade: cole a URL final do arquivo do
# período desejado, ou automatize com Selenium/Playwright.
CEIS_FILE_URL=https://portaldatransparencia.gov.br/download-de-dados/ceis
CNEP_FILE_URL=https://portaldatransparencia.gov.br/download-de-dados/cnep
CEPIM_FILE_URL=https://portaldatransparencia.gov.br/download-de-dados/cepim

# PGFN — Dívida Ativa da União (Não Previdenciário). Muda a cada trimestre;
# se der 404, procure o trimestre atual em https://dadosabertos.pgfn.gov.br/
PGFN_FILE_URL=https://dadosabertos.pgfn.gov.br/2026_trimestre_01/Dados_abertos_Nao_Previdenciario.zip

# IBAMA — Autos de Infração (CSV). Link direto e estável de blob storage.
IBAMA_FILE_URL=https://stibamadadosabertosprd.blob.core.windows.net/dados-abertos/dados/SIFISC/auto_infracao/auto_infracao/auto_infracao_csv.zip

# --- Notificação de visita no dashboard (opcional) --------------------------
# Telegram Bot API: token do bot (via @BotFather) e chat_id do destinatário
# (via @userinfobot ou getUpdates). Se algum dos dois faltar, a notificação
# simplesmente não é enviada — não trava o dashboard.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
